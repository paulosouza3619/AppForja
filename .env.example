# Público (pode ir para o frontend)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_or_anon_key

# Só no servidor. Nunca prefixe com NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Hotmart. A URL de checkout é pública. O token e o id do produto vêm do painel.
# HOTMART_PRODUCT_ID é o id numérico do payload, não o código P108444964Q da URL.
HOTMART_HOTTOK=
HOTMART_PRODUCT_ID=
HOTMART_CHECKOUT_URL=https://pay.hotmart.com/P108444964Q?bid=1794408607041

# false libera qualquer usuário autenticado (desenvolvimento).
# true exige entitlement active/overdue antes de entrar no app.
BILLING_ENFORCED=false

# true trata OVERDUE como acesso liberado, com aviso. false bloqueia.
BILLING_ALLOW_OVERDUE=true
